# VibeRouter 管理端凭证（后端启动时读取；请勿提交真实值到版本库）
# 复制为 .env 使用：cp .env.example .env
#
# 任意一项留空或缺失时，首次启动会自动补全默认值并写入 .env：
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD_HASH=bcrypt("admin")
#   ADMIN_SESSION_SECRET=随机 32 字节 hex
# 默认密码 admin/admin，首次登录后请尽快在管理端修改。
ADMIN_USERNAME=admin

# 密码的 bcrypt 哈希。生成方式：
#   htpasswd -bnBC 10 "" '你的密码' | tr -d ':\n'
ADMIN_PASSWORD_HASH=

# 管理端会话签名密钥：32 字节的 hex（64 个字符）。生成方式：
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
